# Copy these into the stack's environment variables in Dockhand (or into a file named .env next to
# docker-compose.yml). Every value marked "default" can be left out; the compose file then uses it.
#
# ONE STACK PER PERSON: each person gets their own stack (own folder, own copy of docker-compose.yml,
# own values below). The values marked [per person] must be different for every person.

# ---- Secrets [per person] (no default: set these) ------------------------------------------------
# WAHA_API_KEY: make a long random string (30+ letters and digits). Both containers get the same value from here.
WAHA_API_KEY=change-me
WAHA_DASHBOARD_PASSWORD=change-me
WHATSAPP_SWAGGER_PASSWORD=change-me
# Signs the webhook from WAHA to the archiver. Any long random string.
WAHA_WEBHOOK_HMAC_SECRET=change-me-long-random

# ---- Container names [per person] -----------------------------------------------------------------
# Must be unique across everything on proxynet. The two containers find each other by these names, and
# so does the proxy (Zoraxy), so they are also the targets you enter there.
# Defaults (first person): waha and waha-archiver. Second person example: waha-priya / archiver-priya.
WAHA_CONTAINER=waha
ARCHIVER_CONTAINER=waha-archiver

# ---- Folders on the NAS [per person] ---------------------------------------------------------------
# Where this person's decrypted iOS WhatsApp backups are (read-only). Missing or empty = backup import is
# skipped, nothing fails. Change this to point the archiver at a different backup location.
BACKUP_DIR=/volume1/Backup/WhatsApp
# Where this person's archive database, downloaded media and reports are written.
ARCHIVE_DIR=/volume1/Backup/WhatsApp/waha
# WAHA's own session and media folders (sessions/ and media/ are created inside).
WAHA_DIR=/volume1/docker/waha
# Second person example:
#   BACKUP_DIR=/volume1/Backup/WhatsApp-priya
#   ARCHIVE_DIR=/volume1/Backup/WhatsApp-priya/waha
#   WAHA_DIR=/volume1/docker/waha-priya

# ---- Android backups (optional) ----------------------------------------------------------------------
# The 64-digit key (hex digits only, no spaces) from WhatsApp's end-to-end encrypted backup. With it the
# archiver decrypts msgstore.db.crypt15 itself. Leave empty if this person has no Android backup.
# Each backup goes in its own folder under BACKUP_DIR, e.g. BACKUP_DIR/261016/Databases/msgstore.db.crypt15
# and BACKUP_DIR/261016/Media/.
ANDROID_KEY=
# true (default) when WAHA runs in this stack. false = backup-only stack.
WAHA_ENABLED=true

# ---- Images (default: the ones built in your fork) --------------------------------------------------
# Pin a tag to tie the running WAHA to an exact upstream commit, e.g. ...waha:gows-1a2b3c4
WAHA_IMAGE=ghcr.io/deepakgaur84/waha:gows-latest
ARCHIVER_IMAGE=ghcr.io/deepakgaur84/waha-archiver:latest

# How long (milliseconds) WAHA waits for its GOWS helper to start. Default 60000 (upstream uses 10000, too short on
# a slow NAS). Raise it (for example 180000) if the log shows "GOWS did not start after N ms".
WAHA_GOWS_START_TIMEOUT_MS=60000

# ---- Optional ---------------------------------------------------------------------------------------
TZ=Pacific/Auckland
# First default only; change it afterwards in the reader's Preferences.
WAHA_SYNC_INTERVAL_MINUTES=360
# Logout link shown in the reader (empty = no link).
READER_LOGOUT_URL=https://zauth.dgaur.synology.me/logout
# Message ids the import report checks for (comma separated, empty = none). Leave empty for other people.
PROBE_STANZA_IDS=96E48E72D8E53CA026BCBCFA53FBD0DC,5E153DA8A1CA8509A667
